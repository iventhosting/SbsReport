<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>sbs-report</StaticWebAssetBasePath>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>SbsReport</PackageId>
    <Version>1.0.8</Version>
    <Authors>Serdar ÖZDEMİR (Sobis)</Authors>
    <Company>Sobis</Company>
    <Copyright>Copyright (c) 2026 Serdar ÖZDEMİR / Sobis</Copyright>
    <Description>Sıfır harici bağımlılıklı, yüksek performanslı, açık kaynak (MIT) .NET 10 raporlama motoru ve gömülü Web Designer IDE. Saf C# streaming PDF 1.4 üretici (TrueType glyf/loca font subsetting, tam Türkçe destek), gerçek OOXML Excel (.xlsx) ihracı, 28x küçük ikili Snapshot (.sbsdoc), 11 dışa aktarım formatı ve Master Form desteği sunar. 100.000 satırı 5.2 saniyede PDF'e, 2.1 saniyede Excel'e dönüştürür.</Description>
    <PackageTags>reporting;report-engine;pdf;excel;xlsx;ooxml;word;designer;viewer;aspnetcore;dotnet;dotnet10;zero-dependency;headless;wysiwyg;SbsReport</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/iventhosting/SbsReport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iventhosting/SbsReport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>1.0.8: Veri kaynağı bağlanmamış Data bandı artık kayıt sayısı kadar tekrar etmiyor, bir kez basılıyor. Web Designer: bant silme ve Master Yap ile çıkarılan bantların geri gelmesi düzeltildi; yerleşim sihirbazındaki onay kutusu listesi hizalandı.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

</Project>
