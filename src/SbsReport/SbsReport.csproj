<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>sbs-report</StaticWebAssetBasePath>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>SbsReport</PackageId>
    <Version>1.0.10</Version>
    <Authors>Serdar ÖZDEMİR (Sobis)</Authors>
    <Company>Sobis</Company>
    <Copyright>Copyright (c) 2026 Serdar ÖZDEMİR / Sobis</Copyright>
    <Description>Sıfır harici bağımlılıklı, yüksek performanslı, açık kaynak (MIT) .NET 10 raporlama motoru ve gömülü Web Designer IDE. Saf C# streaming PDF 1.4 üretici (TrueType glyf/loca font subsetting, tam Türkçe destek), gerçek OOXML Excel (.xlsx) ve Word (.docx) ihracı, 28x küçük ikili Snapshot (.sbsdoc), 12 dışa aktarım formatı, Master Form, TextInCells, Hesaplanan Sütunlar, Rapor Denetleyici ve zengin ifade motoru (ToCurrencyWordsTr) sunar.</Description>
    <PackageTags>reporting;report-engine;pdf;excel;xlsx;docx;ooxml;word;designer;viewer;aspnetcore;dotnet;dotnet10;zero-dependency;headless;wysiwyg;SbsReport</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/iventhosting/SbsReport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iventhosting/SbsReport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>1.0.10: NuGet ve Visual Studio için sıfır ham HTML içeren saf Markdown README ve Sobis paket ikonu (icon.png) eklendi. 1.0.9 yeniliklerinin tamamını içerir: OOXML .docx, gelişmiş sayısal .xlsx, AllowHtmlTags (Text &amp; Input), TextInCells, Hesaplanan Sütunlar, ToCurrencyWordsTr, Canlı Rapor Denetleyici, Stil Tasarımcısı, kompakt 3 sekmeli renk paleti, canlı özellik filtreleme, Shift+Ok boyutlandırma ve Ctrl+Ok taşıma.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\README.md" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

</Project>
