{
  "version": "1.0",
  "name": "KurumsalYatayMaster",
  "description": "T.C. İl Sağlık Müdürlüğü — Yatay (A4 Landscape) Sabit Header & Footer Master Form Şablonu",
  "isMasterTemplate": true,
  "masterReportName": null,
  "inheritMasterHeader": true,
  "inheritMasterFooter": true,
  "page": {
    "paperSize": "A4",
    "orientation": "Landscape",
    "widthMm": 297,
    "heightMm": 210,
    "marginTopMm": 5,
    "marginRightMm": 5,
    "marginBottomMm": 5,
    "marginLeftMm": 5,
    "gridSizeMm": 2,
    "showGrid": true,
    "snapToGrid": true,
    "watermark": {
      "enabled": false,
      "text": "SOBİS",
      "fontFamily": "Segoe UI, sans-serif",
      "fontSizePt": 72,
      "color": "#cbd5e1",
      "angle": -35,
      "opacity": 0.12
    }
  },
  "dataSources": [],
  "variables": {},
  "bands": [
    {
      "id": "mhdr0001",
      "type": "PageHeader",
      "name": "MasterPageHeader",
      "heightMm": 24,
      "backgroundColor": "#0f2744",
      "printOnAllPages": true,
      "components": [
        {
          "id": "mh_emblem",
          "type": "Text",
          "name": "MasterKurumRozet",
          "xMm": 4,
          "yMm": 4,
          "widthMm": 48,
          "heightMm": 14,
          "text": "✦ T.C.\nSAĞLIK BAKANLIĞI",
          "fontFamily": "Segoe UI, sans-serif",
          "fontSizePt": 9.5,
          "bold": true,
          "color": "#f8a045",
          "backgroundColor": "transparent",
          "borderWidthPx": 0,
          "hAlign": "left",
          "vAlign": "middle",
          "wordWrap": true
        },
        {
          "id": "mh_title",
          "type": "Text",
          "name": "MasterKurumBaslik",
          "xMm": 60,
          "yMm": 2,
          "widthMm": 167,
          "heightMm": 18,
          "text": "T.C.\nERZURUM VALİLİĞİ\nİL SAĞLIK MÜDÜRLÜĞÜ",
          "fontFamily": "Segoe UI, sans-serif",
          "fontSizePt": 11.5,
          "bold": true,
          "color": "#ffffff",
          "backgroundColor": "transparent",
          "borderWidthPx": 0,
          "hAlign": "center",
          "vAlign": "middle",
          "wordWrap": true
        },
        {
          "id": "mh_date",
          "type": "Text",
          "name": "MasterTarih",
          "xMm": 230,
          "yMm": 4,
          "widthMm": 53,
          "heightMm": 6,
          "text": "Tarih: {Today}",
          "fontFamily": "Segoe UI, sans-serif",
          "fontSizePt": 8.5,
          "bold": true,
          "color": "#f8a045",
          "backgroundColor": "transparent",
          "borderWidthPx": 0,
          "hAlign": "right",
          "vAlign": "middle",
          "wordWrap": false
        },
        {
          "id": "mh_code",
          "type": "Text",
          "name": "MasterRaporAdi",
          "xMm": 230,
          "yMm": 11,
          "widthMm": 53,
          "heightMm": 6,
          "text": "Sistem: Sobis Personel",
          "fontFamily": "Segoe UI, sans-serif",
          "fontSizePt": 8,
          "bold": false,
          "color": "#cbd5e1",
          "backgroundColor": "transparent",
          "borderWidthPx": 0,
          "hAlign": "right",
          "vAlign": "middle",
          "wordWrap": false
        },
        {
          "id": "mh_accent",
          "type": "Shape",
          "name": "MasterAltSerit",
