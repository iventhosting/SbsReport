<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>sbs-report</StaticWebAssetBasePath>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>SbsReport</PackageId>
    <Version>1.0.9</Version>
    <Authors>Serdar ÖZDEMİR (Sobis)</Authors>
    <Company>Sobis</Company>
    <Copyright>Copyright (c) 2026 Serdar ÖZDEMİR / Sobis</Copyright>
    <Description>Sıfır harici bağımlılıklı, yüksek performanslı, açık kaynak (MIT) .NET 10 raporlama motoru ve gömülü Web Designer IDE. Saf C# streaming PDF 1.4 üretici (TrueType glyf/loca font subsetting, tam Türkçe destek), gerçek OOXML Excel (.xlsx) ve Word (.docx) ihracı, 28x küçük ikili Snapshot (.sbsdoc), 12 dışa aktarım formatı, Master Form, TextInCells, Hesaplanan Sütunlar, Rapor Denetleyici ve zengin ifade motoru (ToCurrencyWordsTr) sunar.</Description>
    <PackageTags>reporting;report-engine;pdf;excel;xlsx;docx;ooxml;word;designer;viewer;aspnetcore;dotnet;dotnet10;zero-dependency;headless;wysiwyg;SbsReport</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/iventhosting/SbsReport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iventhosting/SbsReport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>1.0.9: Motor: GrowToHeight, ShrinkFontToFit, ProcessingDuplicates (Hide/Merge), PrintOn, PrintAtBottom, ResetPageNumber, KeepGroupTogether, HideZeros, MaxNumberOfLines, ImageFit, AllowHtmlTags (Text ve çok satırlı Input desteği), EmptyBand, OverlayBand, çok sütunlu DataBand (Columns), TextInCells (TC/IBAN kutucukları) ve Hesaplanan Sütunlar. İfade Motoru: ToCurrencyWordsTr, ToWordsTr, CountDistinct, SumDistinct, RunningSum, Median, First/Last, Tarih/Metin/Switch fonksiyonları. Export: Gerçek OOXML .docx ve sayısal hücre/sütun genişliği destekli gelişmiş .xlsx. Web Designer: Canlı Rapor Denetleyici, Stil Tasarımcısı, Kenarlık Ayarları, sabit boyutlu Sayfa Yapısı ve İfade Düzenleyici, kompakt 3 sekmeli Şeffaf destekli renk paleti, canlı özellik filtreleme ve alfabetik sıralama, 4 ayrı sağ tık menüsü, tıklayınca anında görünen 8 boyutlandırma tutamacı, Shift+Ok boyutlandırma / Ctrl+Ok taşıma, tam sayfa önizleme, tema uyumlu özel diyaloglar ve Sobis ikonu.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

</Project>
